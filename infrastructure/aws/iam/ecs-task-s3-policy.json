{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadModelArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::sentiment-mlops-bucket-2026/models/*"
      ]
    },
    {
      "Sid": "ListModelBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::sentiment-mlops-bucket-2026"
    }
  ]
}